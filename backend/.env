CLOUDINARY_CLOUD_NAME= => { try { const r = await pool.query(`SELECTc.*, COALESCE(NULLIF(cl.nom, ''), 'Client ' || cl.telephone) as client_nom, cl.telephone, cl.whatsapp, cl.adresse FROM commandes c LEFT JOIN clients cl ON c.client_id = cl.id ORDER BY c.date_commande DESC`); res.json(r.rows); } catch (e) {res.status(500).json({ error: 'Erreur' }); } });
CLOUDINARY_API_KEY=rs', authenticateToken, isAdmin, async (req, res) => { try { const r = await pool.query(`SELECT u.id, u.name, u.role, (SELECT COUNT(c.id) FROM commandes c WHERE c.livreur_id = u.id AND c.statut = 'livre') as total_livraisons, COALESCE((SELECT SUM(c.total) FROM commandes c WHERE c.livreur_id = u.id AND c.statut = 'livre'), 0) as total_ca FROM utilisateurs u WHERE u.role = 'livreur'`); res.json(r.rows); } catch (e) { res.status(500).json({ error: 'Erreur' }); } });
CLOUDINARY_API_SECRET= saveurs SET categorie_id=$1, nom=$2, stock=$3 WHERE id=$4', [categorie_id, nom, stock, req.params.id]); await logAction(req.user, 'Modif Saveur', nom); res.json({ success: true }); } catch (e) { res.status(500).json({ error: 'Erreur' }); } });
